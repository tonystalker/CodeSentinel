# sentinel-review environment variables
# Copy this file to .env and fill in your keys.
# .env is gitignored — never commit it.
#
# BYOK (bring your own key): all keys billed to YOUR accounts.
# The package never bundles the maintainer's credentials.

# REQUIRED — get free at https://console.groq.com → API Keys
GROQ_API_KEY=gsk_your_key_here

# OPTIONAL — without this, local FAISS is used instead of Pinecone
# PINECONE_API_KEY=

# OPTIONAL — without this, fixes are reported as unvalidated suggestions only
# E2B_API_KEY=

# OPTIONAL — without this, LangSmith tracing is a no-op
# LANGCHAIN_API_KEY=
